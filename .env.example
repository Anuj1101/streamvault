# Server Port
PORT=5000

# Environment: development | production | test
NODE_ENV=development

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Temporary Directory for media processing (defaults to system temp if blank)
TEMP_DIRECTORY=./temp

# Maximum file size limit in MB
MAX_FILE_SIZE=500

# Python executable (ensure yt-dlp is installed in this python environment)
PYTHON_PATH=python

# Rate Limiting (per 15-minute window)
RATE_LIMIT_MAX=100
ANALYZE_RATE_LIMIT=30
DOWNLOAD_RATE_LIMIT=15
